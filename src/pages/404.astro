---
import PageHeading from '../components/PageHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在。">
  <PageHeading title="页面不存在" description="这个链接可能已经失效，或者文章被移走了。">
    <p class="page-links">
      可以<a href={withBase('/')}>回到首页</a>，或者去<a href={withBase('/archive/')}>归档</a>里找找。
    </p>
  </PageHeading>
</BaseLayout>
