---
import PageHeading from '../../components/PageHeading.astro';
import TermCloud from '../../components/TermCloud.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagUrl, getTags } from '../../utils/posts';

const tags = getTags(await getPublishedPosts());
---

<BaseLayout title="标签" description="按标签浏览文章。">
  <PageHeading
    title="标签"
    description={tags.length ? `共 ${tags.length} 个标签` : '还没有标签。'}
  />
  <TermCloud terms={tags} getUrl={getTagUrl} prefix="#" />
</BaseLayout>
