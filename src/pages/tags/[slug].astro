---
import PageHeading from '../../components/PageHeading.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTags, type TaxonomyTerm } from '../../utils/posts';

export async function getStaticPaths() {
  return getTags(await getPublishedPosts()).map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

const { term } = Astro.props as { term: TaxonomyTerm };
---

<BaseLayout title={`标签：${term.name}`} description={`带有「${term.name}」标签的文章。`}>
  <PageHeading eyebrow="标签" title={`#${term.name}`} description={`${term.posts.length} 篇文章`} />
  <PostList posts={term.posts} label={`带有 ${term.name} 标签的文章`} />
</BaseLayout>
