---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isPublished, sortPosts } from '../../utils/posts';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  const posts = sortPosts((await getCollection('posts')).filter(isPublished));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-detail">
    <p class="post-date">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
    </p>
    <div class="post-detail-content">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <span class="tag" aria-label={`Category: ${post.data.category}`}>
            {post.data.category}
          </span>
          {
            post.data.tags.map((tag) => (
              <span class="tag" aria-label={`Tag: ${tag}`}>
                {tag}
              </span>
            ))
          }
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="post-backlinks">
        <a href={withBase('/')}>返回首页</a>
        <a href={withBase('/archive/')}>返回 Archive</a>
      </footer>
    </div>
  </article>
</BaseLayout>
