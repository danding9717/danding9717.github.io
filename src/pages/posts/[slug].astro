---
import { render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import PostRow from '../../components/PostRow.astro';
import TagList from '../../components/TagList.astro';
import ViewCount from '../../components/ViewCount.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  descriptionRepeatsBody,
  formatDate,
  getBacklinks,
  getExcerpt,
  getPostUrl,
  getPublishedPosts,
  getReadingMinutes,
  getRelatedPosts,
  type Post,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const backlinks = getBacklinks(posts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      backlinks: backlinks.get(post.id) ?? [],
      related: getRelatedPosts(post, posts),
    },
  }));
}

interface Props {
  post: Post;
  backlinks: Post[];
  related: Post[];
}

const { post, backlinks, related } = Astro.props;
const { Content, headings } = await render(post);
// 只有二级标题达到 4 个的长文（通常是合集）才在正文上方放目录。
const sections = headings.filter((heading) => heading.depth === 2);
const showToc = sections.length >= 4;
const showSubtitle = !descriptionRepeatsBody(post);
const tags = [...new Set(post.data.tags)];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || getExcerpt(post)}
  type="article"
  publishedTime={post.data.date}
>
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <p class="post-info" data-pagefind-ignore>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true"> · </span>
        <span>{getReadingMinutes(post)} 分钟阅读</span>
        <ViewCount slug={post.id} />
      </p>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {showSubtitle && <p class="post-subtitle">{post.data.description}</p>}
    </header>

    {
      showToc && (
        <nav class="post-toc" aria-label="文章目录" data-pagefind-ignore>
          <ol>
            {sections.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <footer class="post-footer">
    {
      backlinks.length > 0 && (
        <section class="post-section" aria-labelledby="backlinks-title">
          <h2 class="section-title" id="backlinks-title">提到这篇的文章</h2>
          <ul class="backlinks">
            {backlinks.map((item) => (
              <li>
                <a class="backlink" href={getPostUrl(item)}>
                  <span class="backlink-title">{item.data.title}</span>
                  {item.data.description && <span class="backlink-lede">{item.data.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="post-section" aria-labelledby="related-title">
          <h2 class="section-title" id="related-title">相关文章</h2>
          <ol class="post-rows">
            {related.map((item) => (
              <PostRow post={item} />
            ))}
          </ol>
        </section>
      )
    }

    {tags.length > 0 && <TagList tags={tags} label="标签：" />}

    <Comments term={post.id} />
  </footer>
</BaseLayout>
