---
import PostIndex from '../components/PostIndex.astro';
import PostRow from '../components/PostRow.astro';
import TopicList from '../components/TopicList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME, AUTHOR_NAME_EN, SITE_DESCRIPTION, SITE_INTRO, SITE_TITLE } from '../consts';
import {
  formatDate,
  getFeaturedPosts,
  getPostUrl,
  getPublishedPosts,
  getReadingMinutes,
  getTopics,
} from '../utils/posts';
import { withBase } from '../utils/paths';

const posts = await getPublishedPosts();
const [latest] = posts;
const featured = getFeaturedPosts(posts);
const topics = getTopics(posts);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <p class="intro">我是{AUTHOR_NAME}（{AUTHOR_NAME_EN}），{SITE_INTRO}</p>

  {
    latest ? (
      <>
        <section class="home-section" aria-labelledby="home-latest">
          <h2 class="section-title" id="home-latest">最新</h2>
          <a class="featured-post" href={getPostUrl(latest)}>
            <p class="post-info">
              <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
              <span aria-hidden="true"> · </span>
              <span>{getReadingMinutes(latest)} 分钟阅读</span>
            </p>
            <h3 class="featured-title">{latest.data.title}</h3>
            {latest.data.description && <p class="featured-lede">{latest.data.description}</p>}
            <p class="featured-more">继续阅读 &rarr;</p>
          </a>
        </section>

        {featured.length > 0 && (
          <section class="home-section" aria-labelledby="home-featured">
            <h2 class="section-title" id="home-featured">精选</h2>
            <ol class="post-rows">
              {featured.map((post) => (
                <PostRow post={post} />
              ))}
            </ol>
          </section>
        )}

        {topics.length > 0 && (
          <section class="home-section" aria-labelledby="home-topics">
            <h2 class="section-title" id="home-topics">主题</h2>
            <TopicList topics={topics} />
          </section>
        )}

        <section class="home-section" id="posts" aria-labelledby="home-all">
          <div class="section-head">
            <h2 class="section-title" id="home-all">全部文章</h2>
            <a class="section-link" href={withBase('/search/')}>搜索</a>
          </div>
          <PostIndex posts={posts} />
        </section>
      </>
    ) : (
      <p class="empty-state">还没有发布文章，第一篇正在路上。</p>
    )
  }
</BaseLayout>
