---
import PageHeading from '../../components/PageHeading.astro';
import TermCloud from '../../components/TermCloud.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getCategoryUrl, getPublishedPosts } from '../../utils/posts';

const categories = getCategories(await getPublishedPosts());
---

<BaseLayout title="分类" description="按分类浏览文章。">
  <PageHeading
    title="分类"
    description={categories.length ? `共 ${categories.length} 个分类` : '还没有分类。'}
  />
  <TermCloud terms={categories} getUrl={getCategoryUrl} />
</BaseLayout>
