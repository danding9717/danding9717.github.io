---
import PageHeading from '../../components/PageHeading.astro';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTopics, type Topic } from '../../utils/posts';

export async function getStaticPaths() {
  return getTopics(await getPublishedPosts()).map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props as { topic: Topic };
---

<BaseLayout
  title={`主题：${topic.name}`}
  description={`关于「${topic.name}」的文章。`}
  crumb={{ href: '/topics/', label: '主题' }}
>
  <PageHeading title={`主题 / ${topic.name}`} description={`共 ${topic.posts.length} 篇`} />
  <PostList posts={topic.posts} label={`关于 ${topic.name} 的文章`} />
</BaseLayout>
