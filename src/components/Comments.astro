---
// 文章、Now 页和关于页末尾的评论区，由 giscus 显示，评论存在本仓库的 GitHub Discussions 里。
// 没开 JS、或者 giscus 的脚本加载不了时，整块不显示。
// 评论要现场从 giscus.app 和 GitHub 取，打开页面就开始加载（不等滚到这里），等待时先显示一行「正在加载评论……」。
// 用到的页面在 <head> 里放 <CommentsPreconnect slot="head" />，提前连上 giscus。
import { GISCUS } from '../consts';
import { withBase } from '../utils/paths';

interface Props {
  /**
   * 这一页在 Discussions 里对应的讨论，每页一条。文章用地址名（slug），换域名、改标题都不会和评论断开；
   * 其他页面用页面路径（如 /now/），带斜杠，不会和任何文章的地址名撞上。
   */
  term: string;
}

const { term } = Astro.props;

const config = {
  repo: GISCUS.repo,
  repoId: GISCUS.repoId,
  category: GISCUS.category,
  categoryId: GISCUS.categoryId,
  mapping: 'specific',
  term,
  // 按标题精确匹配讨论，避免 ai 和 ai-tools 这类相近的地址名串到一起。
  strict: '1',
  reactionsEnabled: '0',
  emitMetadata: '0',
  inputPosition: 'bottom',
  lang: 'zh-CN',
};
const giscusOrigin = GISCUS.origin;

// 评论区的两套配色，跟着页面的浅色、深色切换。
const themes = {
  light: withBase('/giscus/light.css'),
  dark: withBase('/giscus/dark.css'),
};
---

{
  GISCUS.categoryId && (
    <section class="post-section comments" aria-labelledby="comments-title" hidden>
      <h2 class="section-title" id="comments-title">评论</h2>
      <div class="comments-frame">
        <p class="comments-status" role="status">正在加载评论……</p>
        <div class="giscus" id="comments" />
      </div>
      <script is:inline define:vars={{ config, themes, giscusOrigin }}>
        const root = document.documentElement;
        const section = document.currentScript.closest('.comments');
        const container = section.querySelector('.giscus');
        const status = section.querySelector('.comments-status');

        // giscus 的 iframe 加载好之前是透明的，先用上面那行灰字顶着；iframe 一出来（它里面也先显示同样一行字）就收起。
        // iframe 出来不等于评论能用：连不上 giscus 时浏览器也会把报错页当成加载完。giscus 发来第一条消息才算真的好了。
        // 15 秒还没等到，多半是网络慢或连不上：先藏起 iframe（位置留着），灰字改成提示刷新；之后等到了再换回来。
        let slow = false;
        const slowTimer = setTimeout(() => {
          slow = true;
          status.textContent = '评论还没加载出来，可以刷新一下试试';
          status.hidden = false;
          container.style.visibility = 'hidden';
        }, 15000);
        container.addEventListener(
          'load',
          () => {
            if (!slow) status.hidden = true;
          },
          { capture: true, once: true },
        );

        function widgetReady() {
          clearTimeout(slowTimer);
          if (!slow) return;
          slow = false;
          status.hidden = true;
          container.style.removeProperty('visibility');
        }

        // giscus 在 iframe 里加载样式表，所以要给完整网址；用当前网址拼，换域名也不用改。
        const pageTheme = () =>
          new URL(root.dataset.theme === 'dark' ? themes.dark : themes.light, location.href).href;

        // iframe 当前用的配色，和它是否已经能接收换色消息。
        let frameTheme = '';
        let frameReady = false;

        function syncTheme() {
          const theme = pageTheme();
          const frame = container.querySelector('iframe');
          if (!frameReady || !frame || theme === frameTheme) return;
          frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, giscusOrigin);
          frameTheme = theme;
        }

        // giscus 新建或重新加载 iframe（例如退出登录）时，记下网址里的配色，等它发来消息再补发当前配色。
        new MutationObserver(() => {
          const frame = container.querySelector('iframe');
          if (!frame) return;
          frameTheme = new URL(frame.src).searchParams.get('theme') ?? '';
          frameReady = false;
        }).observe(container, { childList: true, subtree: true, attributeFilter: ['src'] });

        window.addEventListener('message', (event) => {
          if (event.origin !== giscusOrigin || !event.data?.giscus) return;
          widgetReady();
          frameReady = true;
          syncTheme();
        });

        new MutationObserver(syncTheme).observe(root, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        const script = document.createElement('script');
        script.src = `${giscusOrigin}/client.js`;
        script.async = true;
        script.crossOrigin = 'anonymous';
        Object.assign(script.dataset, config, { theme: pageTheme() });
        script.addEventListener('error', () => {
          clearTimeout(slowTimer);
          section.hidden = true;
        });
        section.hidden = false;
        section.append(script);
      </script>
    </section>
  )
}
