---
import type { Post } from '../utils/posts';
import { formatDate, getExcerpt, getPostUrl } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const url = getPostUrl(post);
const date = formatDate(post.data.date);
const excerpt = getExcerpt(post);
---

<article class="post-preview">
  <p class="post-date">
    <time datetime={post.data.date.toISOString()}>{date}</time>
  </p>
  <h2 class="post-title">
    <a href={url}>{post.data.title}</a>
  </h2>
  <p class="post-meta">
    <span>{post.data.category}</span>
    {
      post.data.tags.map((tag) => (
        <span class="tag" aria-label={`Tag: ${tag}`}>
          {tag}
        </span>
      ))
    }
  </p>
  <p class="post-excerpt">{excerpt}</p>
  <a class="read-more" href={url}>阅读全文</a>
</article>
