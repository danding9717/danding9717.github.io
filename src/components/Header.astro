---
import { AUTHOR_NAME_EN, NAV_LINKS, SITE_TITLE } from '../consts';
import { stripBase, withBase } from '../utils/paths';

export interface Crumb {
  href: string;
  label: string;
}

interface Props {
  crumb?: Crumb;
}

const { crumb } = Astro.props;
const logoImage = `url("${withBase('/logo.png')}")`;
const currentPath = stripBase(Astro.url.pathname);
---

<header class="site-header">
  <p class="site-title">
    <a class="site-home" href={withBase('/')}>
      <span class="site-logo" style={`--logo-image: ${logoImage}`} aria-hidden="true"></span>
      <span>{SITE_TITLE}</span>
      <span class="site-name-en">{AUTHOR_NAME_EN}</span>
    </a>
    {
      crumb && (
        <>
          <span class="crumb-separator" aria-hidden="true">/</span>
          <a class="crumb" href={withBase(crumb.href)}>{crumb.label}</a>
        </>
      )
    }
  </p>

  <nav class="site-nav" aria-label="主导航">
    {
      NAV_LINKS.map((link) => (
        <a
          href={withBase(link.href)}
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button class="theme-toggle" type="button" aria-label="切换深色模式（快捷键 D）" aria-pressed="false">
      <span class="theme-toggle-knob" aria-hidden="true"></span>
    </button>
  </nav>
</header>
