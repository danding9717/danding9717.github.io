---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import { stripBase, withBase } from '../utils/paths';

const logoImage = `url("${withBase('/logo.png')}")`;
const currentPath = stripBase(Astro.url.pathname);

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <a class="site-title" href={withBase('/')}>
    <span class="site-logo" style={`--logo-image: ${logoImage}`} aria-hidden="true"></span>
    <span>{SITE_TITLE}</span>
  </a>

  <nav class="site-nav" aria-label="主导航">
    {
      NAV_LINKS.map((link) => (
        <a
          href={withBase(link.href)}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="header-actions">
    <a class="icon-button" href={withBase('/search/')} aria-label="搜索">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4.5 4.5"></path>
      </svg>
    </a>
    <div class="theme-switcher" role="group" aria-label="主题切换">
      <button
        class="theme-option"
        type="button"
        data-theme-option="light"
        aria-label="切换为浅色主题"
        aria-pressed="true"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
      </button>
      <button
        class="theme-option"
        type="button"
        data-theme-option="dark"
        aria-label="切换为深色主题"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
