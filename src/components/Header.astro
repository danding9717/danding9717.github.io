---
import { NAV_LINKS, SITE_TITLE } from '../consts';
import { stripBase, withBase } from '../utils/paths';

const currentPath = stripBase(Astro.url.pathname);
---

<header class="site-header">
  <a class="site-title" href={withBase('/')}>{SITE_TITLE}</a>

  <nav class="site-nav" aria-label="主导航">
    {
      NAV_LINKS.map((link) => (
        <a
          href={withBase(link.href)}
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <button class="theme-toggle" type="button" aria-label="切换深色模式（快捷键 D）" aria-pressed="false">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>
