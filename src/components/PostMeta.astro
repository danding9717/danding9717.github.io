---
import type { Post } from '../utils/posts';
import { getCategoryUrl, getTagUrl } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<p class="post-meta" data-pagefind-ignore>
  <a class="tag tag-category" href={getCategoryUrl(post.data.category)}>
    {post.data.category}
  </a>
  {
    post.data.tags.map((tag) => (
      <a class="tag" href={getTagUrl(tag)}>
        #{tag}
      </a>
    ))
  }
</p>
