---
import Header from '../components/Header.astro';
import { AUTHOR_NAME, OG_IMAGE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** 分享图（站内路径，1200×630）。不给时用站标，卡片是小图。 */
  image?: string;
  /** 放进 <head> 的结构化数据（schema.org），让搜索引擎知道这页是文章、作者是谁。 */
  jsonLd?: Record<string, unknown>;
}

const { title = SITE_TITLE, type = 'website', publishedTime, image, jsonLd } = Astro.props;
// 摘要是空的（比如文章没写导语、正文第一段也没有字）时用网站介绍。
const description = Astro.props.description || SITE_DESCRIPTION;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(withBase(image ?? '/logo.png'), Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      image && (
        <>
          <meta property="og:image:width" content={String(OG_IMAGE.width)} />
          <meta property="og:image:height" content={String(OG_IMAGE.height)} />
          <meta property="og:image:alt" content={title} />
        </>
      )
    }
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      jsonLd && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
      )
    }
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2d2d2b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // 尽早写上 data-theme，避免闪一下另一套颜色。手动选过的主题存在 localStorage 里。
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('dan-ding-theme');
        } catch {}
        const manual = stored === 'light' || stored === 'dark';
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = manual ? stored : system;
        document.documentElement.dataset.theme = theme;
        if (manual) {
          const color = theme === 'dark' ? '#2d2d2b' : '#f9f9f7';
          document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
            meta.setAttribute('content', color);
          });
        }
      })();
    </script>
    <link
      rel="icon"
      href={withBase('/site-icons/dan-hu-favicon-32.png')}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="icon"
      href={withBase('/site-icons/dan-hu-favicon-16.png')}
      type="image/png"
      sizes="16x16"
    />
    <link
      rel="shortcut icon"
      href={withBase('/site-icons/dan-hu-favicon.ico')}
    />
    <link
      rel="apple-touch-icon"
      href={withBase('/site-icons/dan-hu-apple-touch.png')}
      sizes="180x180"
    />
    <link
      rel="mask-icon"
      href={withBase('/site-icons/dan-hu-safari-pinned.svg')}
      color="#000000"
    />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={withBase('/rss.xml')}
    />
    {/* 个别页面自己要加的，比如文章页提前连上评论区的服务器。 */}
    <slot name="head" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <script is:inline>
      (() => {
        const themeKey = 'dan-ding-theme';
        const colors = { light: '#f9f9f7', dark: '#2d2d2b' };
        const media = matchMedia('(prefers-color-scheme: dark)');
        const toggle = document.querySelector('.theme-toggle');
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const systemTheme = () => (media.matches ? 'dark' : 'light');

        function readStored() {
          try {
            const stored = localStorage.getItem(themeKey);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch {
            return null;
          }
        }

        function applyTheme(theme, manual) {
          document.documentElement.dataset.theme = theme;
          toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
          metas.forEach((meta) => {
            const own = meta.media.includes('dark') ? colors.dark : colors.light;
            meta.setAttribute('content', manual ? colors[theme] : own);
          });
        }

        // 切到和系统一致的主题时清掉记录，回到「跟随系统」。
        function toggleTheme() {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          const manual = next !== systemTheme();
          try {
            if (manual) localStorage.setItem(themeKey, next);
            else localStorage.removeItem(themeKey);
          } catch {}
          applyTheme(next, manual);
        }

        const stored = readStored();
        applyTheme(stored ?? systemTheme(), Boolean(stored));
        toggle?.addEventListener('click', toggleTheme);

        media.addEventListener('change', () => {
          if (!readStored()) applyTheme(systemTheme(), false);
        });

        // 按 D 键切换；在输入框里、用输入法打字或按着修饰键时不触发。
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'd' && event.key !== 'D') return;
          if (event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return;
          const target = event.target;
          if (target instanceof HTMLElement && target.closest('input, textarea, select, [contenteditable]')) {
            return;
          }
          toggleTheme();
        });

        // 正文二、三级标题左侧的 # 锚点，悬停时出现。
        document.querySelectorAll('.prose > h2[id], .prose > h3[id]').forEach((heading) => {
          const anchor = document.createElement('a');
          anchor.className = 'anchor';
          anchor.href = `#${heading.id}`;
          anchor.textContent = '#';
          anchor.tabIndex = -1;
          anchor.setAttribute('aria-hidden', 'true');
          anchor.dataset.pagefindIgnore = '';
          heading.prepend(anchor);
        });
      })();
    </script>
  </body>
</html>
